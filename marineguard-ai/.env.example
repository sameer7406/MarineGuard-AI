# ==========================================
# MARINEGUARD AI - ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=5000
FASTAPI_URL=http://localhost:8000
MONGODB_URI=mongodb://127.0.0.1:27017/marineguard_db
JWT_SECRET=marineguard_super_secret_jwt_key_2026_production_safe

# Sentinel-2 & Satellite API Integration Credentials (Optional - fallback to DEMO MODE if absent)
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret_here
COPERNICUS_CDSE_USERNAME=your_copernicus_username_here
COPERNICUS_CDSE_PASSWORD=your_copernicus_password_here

# Ocean Current & Weather Data API Credentials (Optional - uses Open-Meteo / Copernicus Marine physics fallback)
OCEAN_DATA_API_KEY=your_ocean_currents_api_key_here
NOAA_WEATHER_API_KEY=your_noaa_api_key_here

# AIS Maritime Vessel Tracking API (Optional - uses visual radar & simulation fallback)
AIS_STREAM_API_KEY=your_aisstream_api_key_here
